FROM eclipse-temurin:17-jre-noble

WORKDIR /app

# Tạo user không phải root để chạy ứng dụng
RUN useradd --system --uid 10001 --create-home appuser

# Đóng gói đúng JAR đã được Job CI kiểm thử
COPY --chown=10001:10001 build/libs/docker-spring-lab-0.0.1-SNAPSHOT.jar app.jar

USER 10001:10001

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
